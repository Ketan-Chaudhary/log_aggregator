{
  "stats_port": 8080,
  "dlq_path": "dead_letters.jsonl",
  "collector": {
    "paths": [
      "app.log",
      "test.log"
    ],
    "bookmark_file": "bookmarks.json"
  },
  "processor": {
    "workers": 4,
    "min_level": "INFO",
    "drop_regexes": [
      "healthcheck",
      "metric_ping"
    ],
    "labels": {
      "environment": "production",
      "service": "backend"
    },
    "label_mode": "flattened",
    "regex_patterns": [
      "(?P<timestamp>\\S+ \\S+) \\[(?P<level>[A-Z]+)\\] (?P<msg>.*)"
    ]
  },
  "output": {
    "type": "stdout",
    "elasticsearch": {
      "urls": ["http://127.0.0.1:9200"],
      "index": "logs-index",
      "batch_size": 100,
      "flush_period_ms": 5000
    }
  }
}
