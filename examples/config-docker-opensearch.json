{
  "stats_port": 8080,
  "dlq_path": "/var/log/aggregator/dead_letters.jsonl",
  "collector": {
    "paths": ["/var/log/aggregator/*.log"],
    "bookmark_file": "/var/log/aggregator/bookmarks-docker.json"
  },
  "processor": {
    "workers": 2,
    "min_level": "INFO",
    "labels": {
      "cloud": "docker-compose-opensearch",
      "region": "local"
    },
    "label_mode": "nested"
  },
  "output": {
    "type": "opensearch",
    "opensearch": {
      "urls": ["http://opensearch:9200"],
      "index": "docker-opensearch-logs",
      "batch_size": 100,
      "flush_period_ms": 5000
    }
  }
}
