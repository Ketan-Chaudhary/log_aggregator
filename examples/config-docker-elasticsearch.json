{
  "stats_port": 8080,
  "dlq_path": "/var/log/aggregator/dead_letters.jsonl",
  "collector": {
    "paths": ["/var/log/aggregator/*.log"],
    "bookmark_file": "/var/log/aggregator/bookmarks-docker.json"
  },
  "processor": {
    "workers": 4,
    "min_level": "INFO",
    "drop_regexes": ["healthcheck", "metric_ping"],
    "labels": {
      "environment": "docker-compose-production",
      "service": "api-gateway"
    },
    "label_mode": "flattened",
    "regex_patterns": [
      "(?P<timestamp>\\S+ \\S+) \\[(?P<level>[A-Z]+)\\] (?P<msg>.*)"
    ]
  },
  "output": {
    "type": "elasticsearch",
    "elasticsearch": {
      "urls": ["http://elasticsearch:9200"],
      "index": "api-gateway-logs",
      "batch_size": 100,
      "flush_period_ms": 3000
    }
  }
}
