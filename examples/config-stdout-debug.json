{
  "stats_port": 8081,
  "dlq_path": "dead_letters.jsonl",
  "collector": {
    "paths": ["test.log", "app.log"],
    "bookmark_file": "bookmarks.json"
  },
  "processor": {
    "workers": 1,
    "min_level": "DEBUG",
    "regex_patterns": [
      "(?P<timestamp>\\S+ \\S+) \\[(?P<level>[A-Z]+)\\] (?P<msg>.*)"
    ]
  },
  "output": {
    "type": "stdout"
  }
}
