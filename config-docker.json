{
  "stats_port": 8080,
  "dlq_path": "/var/log/aggregator/dead_letters.jsonl",
  "collector": {
    "paths": ["/var/log/aggregator/*.log"],
    "bookmark_file": "/var/log/aggregator/bookmarks-docker.json"
  },
  "processor": {
    "workers": 2,
    "min_level": "INFO",
    "labels": {
      "environment": "docker-compose-test",
      "service": "log-aggregator"
    },
    "label_mode": "nested"
  },
  "output": {
    "type": "elasticsearch",
    "elasticsearch": {
      "urls": ["http://elasticsearch:9200"],
      "index": "logs-docker",
      "batch_size": 100,
      "flush_period_ms": 1000
    }
  }
}
